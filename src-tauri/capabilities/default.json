{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:scope-cache-recursive",
    "fs:allow-cache-read",
    "fs:allow-cache-write"
  ]
}